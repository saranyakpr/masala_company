# Contact form delivery endpoint (e.g. Formspree, a serverless function, or your own API).
# The form POSTs JSON { name, email, phone, subject, message }.
# Leave empty until a real backend/email service is configured — the form will then
# tell visitors that online delivery is not yet connected and offer a mailto fallback.
VITE_CONTACT_ENDPOINT=

# Public site URL used for canonical and Open Graph tags.
VITE_SITE_URL=https://www.example.com
